# DeepSeek / LLM
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_PROVIDER=deepseek
LLM_ENABLE=true

# Agnes AI video generation
AGNES_API_KEY=your_agnes_api_key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_VIDEO_MODEL=agnes-video-v2.0

# Local data-structure knowledge base. All supported files under this folder are imported.
KNOWLEDGE_BASE_PATH=E:\知识库
LOCAL_KB_VECTOR_INDEX_LIMIT=0
LOCAL_KB_MAX_PDF_PAGES=80
LOCAL_KB_MAX_PARSE_PDF_BYTES=5000000
LOCAL_KB_PARSE_LARGE_PDF=false
LOCAL_KB_FULL_PARSE_FILE_LIMIT=8
LOCAL_KB_MAX_ZIP_PARSE_ENTRIES=20
KNOWLEDGE_VECTOR_QUERY_ENABLE=false

# Local open video generation / FFmpeg MP4 normalization
LOCAL_VIDEO_CACHE_PATH=
LOCAL_VIDEO_MODEL_MODE=cache_first

# 画像向量化
VECTOR_EMBEDDING_MODE=real
EMBEDDING_MODEL=BAAI/bge-m3

# 向量库：chroma / milvus / sqlite
VECTOR_STORE=chroma

# ChromaDB 本地持久化路径
CHROMA_PATH=backend/data/chroma

# Milvus（可选）
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=

# Agent 编排与状态管理
# custom：使用内置轻量工作流；langgraph：安装 requirements-agent.txt 后启用 LangGraph
AGENT_ORCHESTRATOR=custom

# structured：结构化 Agent 消息；autogen：安装 pyautogen 后可作为多 Agent 对话扩展
AGENT_COLLAB_MODE=structured

# Redis 可选；配置后用于镜像任务快照和 Agent 事件，SQLite 仍作为持久化来源
REDIS_URL=
AGENT_STATE_PREFIX=eduagent
AGENT_STATE_TTL_SECONDS=86400
